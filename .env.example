# --- SPORTZ environment configuration ---
# Copy this file to `.env` and adjust as needed. Every value is optional.

# Port the server listens on (default 3000)
PORT=3000

# Sports-data provider:
#   espn = real public ESPN API (keyless, default) with a demo fallback
#   demo = always use the scripted demo schedule
SPORTS_PROVIDER=espn

# Override the sports API base URL (optional; used for tests or a self-hosted proxy)
# SPORTS_API_URL=https://site.api.espn.com/apis/site/v2

# Starting virtual coin balance for new accounts (virtual only, no real money)
STARTING_BALANCE=10000

# Location of the SQLite database file (optional)
# DB_PATH=./data/sportz.db